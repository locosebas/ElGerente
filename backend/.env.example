# Copiar a .env y ajustar. El .env no se sube al repo.

# --- Base de datos ---
# SQLite local (por defecto, cero infraestructura):
DATABASE_URL=sqlite+aiosqlite:///./elgerente.db
# PostgreSQL (cuando haga falta multiusuario / más volumen): solo se cambia esta línea,
# ningún código más.
# DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/elgerente

# --- WhatsApp (Módulo 2) ---
# Proveedor activo: "fake" (para desarrollo / tests, no envía nada real) o "meta".
WHATSAPP_PROVEEDOR=fake
# Token que Meta usa para verificar el webhook (lo eliges tú al configurar el webhook).
WHATSAPP_VERIFY_TOKEN=cambia-esto
# Credenciales de Meta Cloud API (solo si WHATSAPP_PROVEEDOR=meta):
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# --- General ---
# "dev" o "prod": afecta logging y el modo debug.
ENTORNO=dev

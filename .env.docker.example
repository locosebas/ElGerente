# Variables para docker compose. Copiar a .env.docker (que NO se sube al repo).
#   cp .env.docker.example .env.docker
# docker compose lee automáticamente un archivo llamado .env; si preferís .env.docker,
# usá:  docker compose --env-file .env.docker up --build

# Clave de PostgreSQL (cambiala para algo real antes de exponerlo).
POSTGRES_PASSWORD=elgerente
